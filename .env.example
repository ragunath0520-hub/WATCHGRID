# ========================================================
# WATCHGRID — Docker Compose Environment Configuration
# ========================================================

# SQLite Database (Embedded file-based storage, no PostgreSQL required)
DATABASE_URL=sqlite:////app/data/watchgrid.db

# FastAPI Backend Service
BACKEND_PORT=8000
JWT_SECRET=super-secret-security-jwt-key-watchgrid-cyber-defense-soc-2026-xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AGENT_API_KEY=watchgrid-agent-key-alpha-99
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
AUTO_SEED=true

# Next.js Frontend SOC Operations Dashboard
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Endpoint Security Agent (Active when using --profile agent)
WATCHGRID_DEVICE_ID=DEV-DOCKER-AGENT-01
WATCHGRID_DEVICE_NAME=Docker SOC Sensor Node
WATCHGRID_HEARTBEAT_INTERVAL=15
