# WATCHGRID Backend Environment Configuration Example
# Copy this file to .env and adjust credentials

# Database URL (Supports Neon PostgreSQL or local PostgreSQL/SQLite fallback)
# Neon example: postgresql+psycopg://user:password@ep-xyz-123.us-east-2.aws.neon.tech/watchgrid?sslmode=require
DATABASE_URL=sqlite:///./watchgrid.db

# JWT Authentication
JWT_SECRET=super-secret-security-jwt-key-watchgrid-cyber-defense-soc-2026-xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ingestion API Key (Optional device agent authentication)
AGENT_API_KEY=watchgrid-agent-key-alpha-99

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
